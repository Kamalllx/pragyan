# MongoDB (optional). Without it Pragyan falls back to a local JSON store in storage/localdb.
MONGODB_URI="mongodb+srv://user:password@cluster.example.mongodb.net/"
MONGODB_DB=pragyan_ai

# Models (all served by Ollama). Any model with vision works for MODEL_VISION.
MODEL_REASON=qwen3.5:9b
MODEL_CODE=qwen3.5:9b
MODEL_VISION=qwen3.5:9b
MODEL_EMBED=nomic-embed-text
# Raise only if you have VRAM for parallel requests (OLLAMA_NUM_PARALLEL on the Ollama side too).
LLM_CONCURRENCY=1
SOLVER_THINK=true
